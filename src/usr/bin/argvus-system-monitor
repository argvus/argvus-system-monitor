#!/usr/bin/env sh
# Launch btop with the ARGVUS configuration and currently active ARGVUS theme.

set -eu

: "${HOME:?HOME is not set}"

SYSTEM_ROOT="${ARGVUS_SYSTEM_MONITOR_CONFIG:-/usr/share/argvus-system-monitor}"
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
ARGVUS_DIR="${ARGVUS_CONFIG_DIR:-$HOME/.config/argvus}"
ACTIVE_THEME_FILE="${ARGVUS_ACTIVE_THEME_FILE:-$ARGVUS_DIR/.active-theme}"
DEFAULT_THEME="argvus-dark-aether"

BTOP_CONFIG="${SYSTEM_ROOT}/btop/btop.conf"
BTOP_THEMES_DIR="${SYSTEM_ROOT}/btop/themes"
RUNTIME_DIR="${CACHE_HOME}/argvus/argvus-system-monitor"
RUNTIME_CONFIG="${RUNTIME_DIR}/btop.conf"

usage() {
  cat <<'USAGE'
Usage:
  argvus-system-monitor [btop options]
  argvus-system-monitor --mem [btop options]
  argvus-system-monitor --cpu [btop options]
  argvus-system-monitor --net [btop options]
  argvus-system-monitor --proc [btop options]
  argvus-system-monitor --print-config
  argvus-system-monitor --print-theme

Module shortcuts:
  --mem   Show only memory/disks
  --cpu   Show only CPU
  --net   Show only network
  --proc  Show only processes

With no module shortcut, all standard boxes are shown.

The active theme is read from:
  ~/.config/argvus/.active-theme
USAGE
}

die() {
  printf 'argvus-system-monitor: %s\n' "$*" >&2
  exit 1
}

read_active_theme() {
  if [ -r "$ACTIVE_THEME_FILE" ]; then
    _theme="$(sed -n '1{s/\r$//;s/^[[:space:]]*//;s/[[:space:]]*$//;p;}' "$ACTIVE_THEME_FILE")"
  else
    _theme=""
  fi

  [ -n "$_theme" ] || _theme="$DEFAULT_THEME"

  if [ ! -f "$BTOP_THEMES_DIR/${_theme}.theme" ]; then
    printf 'argvus-system-monitor: theme "%s" from %s was not found; using "%s"\n' \
      "$_theme" "$ACTIVE_THEME_FILE" "$DEFAULT_THEME" >&2
    _theme="$DEFAULT_THEME"
  fi

  printf '%s\n' "$_theme"
}

build_runtime_config() {
  _theme="$1"
  _shown_boxes="$2"

  [ -f "$BTOP_CONFIG" ] || die "btop config not found: $BTOP_CONFIG"
  [ -d "$BTOP_THEMES_DIR" ] || die "btop themes directory not found: $BTOP_THEMES_DIR"

  mkdir -p "$RUNTIME_DIR"

  sed \
    -e "s|^[[:space:]]*color_theme[[:space:]]*=.*|color_theme = \"${_theme}\"|" \
    -e "s|^[[:space:]]*shown_boxes[[:space:]]*=.*|shown_boxes = \"${_shown_boxes}\"|" \
    "$BTOP_CONFIG" > "$RUNTIME_CONFIG"

  if ! grep -q '^[[:space:]]*color_theme[[:space:]]*=' "$RUNTIME_CONFIG"; then
    printf '\ncolor_theme = "%s"\n' "$_theme" >> "$RUNTIME_CONFIG"
  fi

  if ! grep -q '^[[:space:]]*shown_boxes[[:space:]]*=' "$RUNTIME_CONFIG"; then
    printf 'shown_boxes = "%s"\n' "$_shown_boxes" >> "$RUNTIME_CONFIG"
  fi
}

has_explicit_btop_paths() {
  for _arg in "$@"; do
    case "$_arg" in
      -c|--config|--config=*|--themes-dir|--themes-dir=*)
        return 0
        ;;
    esac
  done

  return 1
}

SHOWN_BOXES="cpu mem net proc"

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;

  --mem)
    SHOWN_BOXES="mem"
    shift
    ;;

  --cpu)
    SHOWN_BOXES="cpu"
    shift
    ;;

  --net)
    SHOWN_BOXES="net"
    shift
    ;;

  --proc)
    SHOWN_BOXES="proc"
    shift
    ;;

  --print-theme)
    read_active_theme
    exit 0
    ;;

  --print-config)
    _theme="$(read_active_theme)"
    build_runtime_config "$_theme" "$SHOWN_BOXES"
    printf '%s\n' "$RUNTIME_CONFIG"
    exit 0
    ;;
esac

# Always launch the graphical/system-monitor invocation inside Foot.
#
# ARGVUS_SYSTEM_MONITOR_IN_FOOT prevents an infinite loop:
#
# argvus-system-monitor
#   -> foot argvus-system-monitor
#       -> btop
#
# Respect explicit btop paths supplied by the user.
if has_explicit_btop_paths "$@"; then
  exec btop "$@"
fi

ACTIVE_THEME="$(read_active_theme)"
build_runtime_config "$ACTIVE_THEME" "$SHOWN_BOXES"

btop \
--config "$RUNTIME_CONFIG" \
--themes-dir "$BTOP_THEMES_DIR" \
"$@"