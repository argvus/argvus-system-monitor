#!/usr/bin/env sh
# Launch btop with the ARGVUS configuration and currently active ARGVUS theme.

set -eu

: "${HOME:?HOME is not set}"

SYSTEM_ROOT="${ARGVUS_SYSTEM_MONITOR_CONFIG:-/usr/share/argvus-system-monitor}"
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
ARGVUS_DIR="${ARGVUS_CONFIG_DIR:-$HOME/.config/argvus}"
ACTIVE_THEME_FILE="${ARGVUS_ACTIVE_THEME_FILE:-$ARGVUS_DIR/.active-theme}"
DEFAULT_THEME="argvus-dark-aether"

BTOP_CONFIG="${SYSTEM_ROOT}/btop/btop.conf"
BTOP_THEMES_DIR="${SYSTEM_ROOT}/btop/themes"
RUNTIME_DIR="${CACHE_HOME}/argvus/argvus-system-monitor"
RUNTIME_CONFIG="${RUNTIME_DIR}/btop.conf"

usage() {
  cat <<'USAGE'
Usage:
  argvus-system-monitor [btop options]
  argvus-system-monitor --print-config
  argvus-system-monitor --print-theme

The active theme is read from:
  ~/.config/argvus/.active-theme
USAGE
}

die() {
  printf 'argvus-system-monitor: %s\n' "$*" >&2
  exit 1
}

read_active_theme() {
  if [ -r "$ACTIVE_THEME_FILE" ]; then
    # Read only the first line and strip CR/leading/trailing whitespace.
    _theme="$(sed -n '1{s/\r$//;s/^[[:space:]]*//;s/[[:space:]]*$//;p;}' "$ACTIVE_THEME_FILE")"
  else
    _theme=""
  fi

  [ -n "$_theme" ] || _theme="$DEFAULT_THEME"

  if [ ! -f "$BTOP_THEMES_DIR/${_theme}.theme" ]; then
    printf 'argvus-system-monitor: theme "%s" from %s was not found; using "%s"\n' \
      "$_theme" "$ACTIVE_THEME_FILE" "$DEFAULT_THEME" >&2
    _theme="$DEFAULT_THEME"
  fi

  printf '%s\n' "$_theme"
}

build_runtime_config() {
  _theme="$1"

  [ -f "$BTOP_CONFIG" ] || die "btop config not found: $BTOP_CONFIG"
  [ -d "$BTOP_THEMES_DIR" ] || die "btop themes directory not found: $BTOP_THEMES_DIR"

  mkdir -p "$RUNTIME_DIR"

  # Keep the packaged btop configuration intact and change only color_theme.
  # btop resolves this theme name through --themes-dir below.
  if grep -q '^[[:space:]]*color_theme[[:space:]]*=' "$BTOP_CONFIG"; then
    sed "s|^[[:space:]]*color_theme[[:space:]]*=.*|color_theme = \"${_theme}\"|" \
      "$BTOP_CONFIG" > "$RUNTIME_CONFIG"
  else
    {
      printf 'color_theme = "%s"\n' "$_theme"
      cat "$BTOP_CONFIG"
    } > "$RUNTIME_CONFIG"
  fi
}

has_explicit_btop_paths() {
  for _arg in "$@"; do
    case "$_arg" in
      -c|--config|--config=*|--themes-dir|--themes-dir=*) return 0 ;;
    esac
  done
  return 1
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  --print-theme)
    read_active_theme
    exit 0
    ;;
  --print-config)
    _theme="$(read_active_theme)"
    build_runtime_config "$_theme"
    printf '%s\n' "$RUNTIME_CONFIG"
    exit 0
    ;;
esac

# Respect explicit btop paths supplied by the user.
if has_explicit_btop_paths "$@"; then
  exec btop "$@"
fi

# Generate a runtime config whose color_theme matches
# ~/.config/argvus/.active-theme, then replace this wrapper with btop itself.
#
# Keep btop in the foreground. Starting it with `&` from this non-interactive
# wrapper can detach stdin from the controlling terminal, which makes btop
# abort with: "ERROR: No tty detected!".
ACTIVE_THEME="$(read_active_theme)"
build_runtime_config "$ACTIVE_THEME"

exec btop --config "$RUNTIME_CONFIG" --themes-dir "$BTOP_THEMES_DIR" "$@"
